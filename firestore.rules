rules_version = '2';
// Matches, payments and shortlists are written only by the weekly engine (admin SDK bypasses rules).
// Clients can: edit their own application, opt in to a week, place a bid, answer an invitation,
// tap "I've arrived", and report. Nobody can read anyone else's profile.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /admins/{uid} {
      allow read: if signedIn() && me() == uid;
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow create: if signedIn() && me() == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.verified == false
        && request.resource.data.role in ['woman', 'man'];
      allow update: if isAdmin()
        // always editable by the member
        || (signedIn() && me() == uid
            && changed().hasOnly(['logistics', 'fcmTokens', 'area', 'updatedAt']))
        // editable only while the application is still being reviewed
        || (signedIn() && me() == uid
            && resource.data.status in ['pending', 'waitlist']
            && changed().hasOnly(['firstName', 'age', 'area', 'prefs', 'answers', 'dealbreakers', 'logistics',
                                  'profession', 'prompts', 'profileLink', 'consent', 'fcmTokens', 'updatedAt']));
      allow delete: if signedIn() && me() == uid;
    }

    // Selfie for the verification call. Visible to the member and our team only; deleted on approval.
    match /verifications/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow create, update: if signedIn() && me() == uid && request.resource.data.selfie.size() < 250000;
      allow delete: if signedIn() && (me() == uid || isAdmin());
    }

    // Weekly opt-in. Document id is "<weekId>_<uid>".
    match /optins/{optinId} {
      allow read: if signedIn() && (optinId.matches('.*_' + me()) || isAdmin());
      allow create, update: if signedIn()
        && optinId == request.resource.data.weekId + '_' + me()
        && request.resource.data.uid == me()
        && request.resource.data.slots is list && request.resource.data.slots.size() > 0 && request.resource.data.slots.size() <= 4
        && get(/databases/$(database)/documents/users/$(me())).data.status == 'approved'
        && request.resource.data.role == get(/databases/$(database)/documents/users/$(me())).data.role;
      allow delete: if signedIn() && optinId.matches('.*_' + me());
    }

    // Shortlist openings for men. A bid can only be placed before the deadline, within limits.
    match /openings/{id} {
      allow read: if signedIn() && (resource.data.forUid == me() || isAdmin());
      allow update: if signedIn() && resource.data.forUid == me()
        && resource.data.status == 'open'
        && request.time.toMillis() < resource.data.closesAtMs
        && changed().hasOnly(['bid', 'bidAt'])
        && (request.resource.data.bid == null
            || (request.resource.data.bid is int
                && request.resource.data.bid >= resource.data.minBid
                && request.resource.data.bid <= resource.data.bidCap));
    }

    // One doc per evening, shared by both people. Money lives elsewhere, so women never see it.
    match /dates/{id} {
      allow read: if signedIn() && (
        resource.data.manUid == me()
        || (resource.data.womanUid == me()
            && resource.data.status in ['offered', 'confirmed', 'declined', 'completed', 'noshow_w', 'noshow_m', 'expired'])
        || isAdmin());
      allow update: if signedIn() && (
        isAdmin()
        || (resource.data.womanUid == me() && resource.data.status == 'offered'
            && changed().hasOnly(['status', 'respondedAt', 'declineReason'])
            && request.resource.data.status in ['confirmed', 'declined'])
        || (resource.data.womanUid == me() && resource.data.status == 'confirmed'
            && changed().hasOnly(['womanArrivedAt', 'womanSos']))
        || (resource.data.manUid == me() && resource.data.status == 'confirmed'
            && changed().hasOnly(['manArrivedAt', 'manSos'])));
    }

    match /payments/{id} {
      allow read: if signedIn() && (resource.data.manUid == me() || isAdmin());
      allow update: if signedIn() && (
        isAdmin()
        || (resource.data.manUid == me() && resource.data.status == 'due'
            && changed().hasOnly(['status', 'claimedRef', 'claimedAt'])
            && request.resource.data.status == 'claimed'));
    }

    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.byUid == me();
      allow read, update: if isAdmin();
    }

    // edges, cycles: engine only (no client access).
  }
}
